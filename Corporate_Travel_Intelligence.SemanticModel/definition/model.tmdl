model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["aereo_raw","centros_custo_raw","despesas_raw","hospedagem_raw","orcamento_raw","viagens_raw","viajantes_raw"]

annotation PBI_ProTooling = ["DevMode"]

ref table aereo_raw
ref table centros_custo_raw
ref table despesas_raw
ref table hospedagem_raw
ref table orcamento_raw
ref table viagens_raw
ref table viajantes_raw
ref table DimData
ref table _Medidas

ref cultureInfo pt-BR

