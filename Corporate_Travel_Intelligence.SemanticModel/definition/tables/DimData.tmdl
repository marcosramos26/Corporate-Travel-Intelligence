table DimData
	lineageTag: c66ec388-61f4-49ed-b72e-704def1c7351
	dataCategory: Time

	column Data
		isKey
		formatString: General Date
		lineageTag: 27063c6b-426a-4139-bd49-ae907798ec73
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Ano
		formatString: 0
		lineageTag: 1eb5fcd4-c7c7-4269-9b29-8921810d91e1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column MesNumero
		formatString: 0
		lineageTag: 0add902a-f611-4a61-98ff-4f39ec0de02b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [MesNumero]

		annotation SummarizationSetBy = Automatic

	column Mes
		lineageTag: a5cfb1d3-9f33-4102-a8aa-2103b89049c2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]
		sortByColumn: MesNumero

		annotation SummarizationSetBy = Automatic

	column AnoMes
		lineageTag: a3f21eaa-f2db-4a50-8a80-a03a01875179
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoMes]

