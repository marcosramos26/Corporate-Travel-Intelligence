	column Trimestre
		lineageTag: 790e9384-eb0e-4636-8d0a-e519c3bfc4a2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	partition DimData = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2024, 1, 1),
				        DATE(2025, 12, 31)
				    ),
				    "Ano", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "AnoMes", FORMAT([Date], "YYYY-MM"),
				    "Trimestre", "T" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 172f27f561814de795cc15dbe453ee2c

