	measure 'HTML KPI - Gasto Total' =
			VAR _v = [Gasto Total]
			VAR _blank = ISBLANK ( _v )
			VAR _orc = [Orçado]
			VAR _hasBud = NOT ISBLANK ( _orc ) && _orc <> 0
			VAR _desv = [Desvio R$]
			VAR _abs = ABS ( _v )
			VAR _num =
			    SWITCH (
			        TRUE (),
			        _abs >= 1000000000, FORMAT ( _abs / 1000000000, "#,##0.00", "pt-BR" ) & " Bi",
			        _abs >= 1000000, FORMAT ( _abs / 1000000, "#,##0.00", "pt-BR" ) & " Mi",
			        _abs >= 1000, FORMAT ( _abs / 1000, "#,##0.0", "pt-BR" ) & " mil",
			        FORMAT ( _abs, "#,##0", "pt-BR" )
			    )
			VAR _value = IF ( _blank, "—", IF ( _v < 0, "-", "" ) & "R$ " & _num )
			VAR _oAbs = ABS ( _orc )
			VAR _oNum =
			    SWITCH (
			        TRUE (),
			        _oAbs >= 1000000000, FORMAT ( _oAbs / 1000000000, "#,##0.00", "pt-BR" ) & " Bi",
			        _oAbs >= 1000000, FORMAT ( _oAbs / 1000000, "#,##0.00", "pt-BR" ) & " Mi",
			        _oAbs >= 1000, FORMAT ( _oAbs / 1000, "#,##0.0", "pt-BR" ) & " mil",
			        FORMAT ( _oAbs, "#,##0", "pt-BR" )
			    )
			VAR _pct = FORMAT ( ABS ( [Desvio %] ), "#,##0.00%", "pt-BR" )
			VAR _chip =
			    SWITCH (
			        TRUE (),
			        _blank || NOT _hasBud, "",
			        _desv > 0, "<span style='padding:2px 9px;border-radius:999px;background:#FBEAEA;color:#BE3A3A;font-size:11px;font-weight:600;white-space:nowrap;'>▲ " & _pct & " acima</span>",
			        _desv < 0, "<span style='padding:2px 9px;border-radius:999px;background:#E4F4EE;color:#0B7A5A;font-size:11px;font-weight:600;white-space:nowrap;'>▼ " & _pct & " abaixo</span>",
			        "<span style='padding:2px 9px;border-radius:999px;background:#EEF1F5;color:#5B6779;font-size:11px;font-weight:600;white-space:nowrap;'>no orçamento</span>"
			    )
			VAR _caption =
			    IF (
			        _blank,
			        "Sem dados para os filtros atuais",
			        IF ( _hasBud, "Orçado R$ " & IF ( _orc < 0, "-", "" ) & _oNum, "Realizado no período selecionado" )
			    )
			RETURN
			    "<div style='display:flex;flex-direction:column;justify-content:center;height:100%;font-family:Segoe UI,Tahoma,Arial,sans-serif;'>"
			        & "<div style='display:flex;align-items:center;justify-content:space-between;'>"
			            & "<span style='font-size:11px;font-weight:600;letter-spacing:.01em;color:#344054;'>Gasto total</span>"
			            & _chip
			        & "</div>"
			        & "<div style='margin-top:6px;font-size:26px;font-weight:600;color:#172B4D;line-height:1.05;letter-spacing:-.02em;font-variant-numeric:tabular-nums;'>" & _value & "</div>"
			        & "<div style='margin-top:6px;font-size:11px;color:#667085;'>" & _caption & "</div>"
			        & "</div>"
		displayFolder: UI_HTML
		lineageTag: a699b0e2-b69a-4748-aa73-217c28274749

	measure 'HTML KPI - Orçado' =
			VAR _v = [Orçado]
			VAR _blank = ISBLANK ( _v )
			VAR _abs = ABS ( _v )
			VAR _num =
			    SWITCH (
			        TRUE (),
			        _abs >= 1000000000, FORMAT ( _abs / 1000000000, "#,##0.00", "pt-BR" ) & " Bi",
			        _abs >= 1000000, FORMAT ( _abs / 1000000, "#,##0.00", "pt-BR" ) & " Mi",
			        _abs >= 1000, FORMAT ( _abs / 1000, "#,##0.0", "pt-BR" ) & " mil",
			        FORMAT ( _abs, "#,##0", "pt-BR" )
			    )
			VAR _value = IF ( _blank, "—", IF ( _v < 0, "-", "" ) & "R$ " & _num )
			VAR _caption = IF ( _blank, "Sem dados para os filtros atuais", "Orçamento do período selecionado" )
			RETURN
			    "<div style='display:flex;flex-direction:column;justify-content:center;height:100%;padding-left:24px;border-left:1px solid #DCE5F0;font-family:Segoe UI,Tahoma,Arial,sans-serif;'>"
			        & "<span style='font-size:11px;font-weight:600;letter-spacing:.01em;color:#344054;'>Orçado</span>"
			        & "<div style='margin-top:6px;font-size:26px;font-weight:600;color:#172B4D;line-height:1.05;letter-spacing:-.02em;font-variant-numeric:tabular-nums;'>" & _value & "</div>"
			        & "<div style='margin-top:6px;font-size:11px;color:#667085;'>" & _caption & "</div>"
			        & "</div>"
		displayFolder: UI_HTML
		lineageTag: 23d4ba65-7ba8-4851-9737-93ad115af2e8

	measure 'HTML KPI - Desvio vs Orçado' =
			VAR _pct = [Desvio %]
			VAR _rs = [Desvio R$]
			VAR _orc = [Orçado]
			VAR _hasBud = NOT ISBLANK ( _orc ) && _orc <> 0
			VAR _blank = ISBLANK ( _pct )
			VAR _pctTxt = FORMAT ( ABS ( _pct ), "#,##0.00%", "pt-BR" )
			VAR _sign = SWITCH ( TRUE (), _pct > 0, "+", _pct < 0, "−", "" )
			VAR _value = IF ( _blank, "—", _sign & _pctTxt )
			VAR _color = SWITCH ( TRUE (), _pct > 0, "#BE3A3A", _pct < 0, "#0B7A5A", "#172B4D" )
			VAR _rsTxt = "R$ " & FORMAT ( ABS ( _rs ), "#,##0", "pt-BR" )
			VAR _caption =
			    SWITCH (
			        TRUE (),
			        _blank, "Sem dados para os filtros atuais",
			        NOT _hasBud, "Sem orçamento no período",
			        _rs > 0, _rsTxt & " acima do orçamento",
			        _rs < 0, _rsTxt & " abaixo do orçamento",
			        "No orçamento do período"
			    )
			RETURN
			    "<div style='display:flex;flex-direction:column;justify-content:center;height:100%;padding-left:24px;border-left:1px solid #DCE5F0;font-family:Segoe UI,Tahoma,Arial,sans-serif;'>"
			        & "<span style='font-size:11px;font-weight:600;letter-spacing:.01em;color:#344054;'>Desvio vs orçado</span>"
			        & "<div style='margin-top:6px;font-size:26px;font-weight:600;color:" & _color & ";line-height:1.05;letter-spacing:-.02em;font-variant-numeric:tabular-nums;'>" & _value & "</div>"
			        & "<div style='margin-top:6px;font-size:11px;color:#667085;'>" & _caption & "</div>"
			        & "</div>"
		displayFolder: UI_HTML
		lineageTag: ac259b68-0713-47b5-b1b4-4228f4b1c260

	measure 'HTML KPI - Qtd Viagens' =
