            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"data\":{\"name\":\"dataset\"},\"width\":\"container\",\"height\":\"container\",\"autosize\":{\"type\":\"fit\",\"contains\":\"padding\"},\"padding\":{\"left\":0,\"right\":12,\"top\":4,\"bottom\":0},\"title\":{\"text\":\"Desvio por área\",\"subtitle\":[\"Vermelho: acima | Verde: abaixo do orçamento\"],\"anchor\":\"start\",\"font\":\"Segoe UI Semibold\",\"fontSize\":15,\"fontWeight\":600,\"color\":\"#172B4D\",\"subtitleFont\":\"Segoe UI\",\"subtitleFontSize\":10,\"subtitleColor\":\"#6B778C\",\"offset\":18},\"transform\":[{\"filter\":\"isValid(datum.Desvio)\"},{\"calculate\":\"abs(datum.Desvio)\",\"as\":\"AbsDesvio\"},{\"joinaggregate\":[{\"op\":\"max\",\"field\":\"AbsDesvio\",\"as\":\"MaxAbs\"}]},{\"calculate\":\"datum.MaxAbs === 0 ? 0 : datum.Desvio / datum.MaxAbs\",\"as\":\"DesvioNorm\"},{\"calculate\":\"(datum.Desvio < 0 ? \\\"−R$ \\\" : \\\"R$ \\\") + replace(format(abs(datum.Desvio) >= 1000000 ? abs(datum.Desvio)/1000000 : abs(datum.Desvio)/1000, abs(datum.Desvio) >= 1000000 ? \\\".2f\\\" : \\\".1f\\\"), \\\".\\\", \\\",\\\") + (abs(datum.Desvio) >= 1000000 ? \\\" Mi\\\" : \\\" Mil\\\")\",\"as\":\"Rotulo\"}],\"encoding\":{\"y\":{\"field\":\"Area\",\"type\":\"nominal\",\"sort\":{\"op\":\"sum\",\"field\":\"Desvio\",\"order\":\"descending\"},\"axis\":{\"labelPadding\":10,\"labelLimit\":110}}},\"layer\":[{\"mark\":{\"type\":\"rule\",\"color\":\"#CBD5E1\",\"strokeWidth\":1},\"encoding\":{\"x\":{\"datum\":0,\"scale\":{\"domain\":[-1.15,1.15]}}}},{\"mark\":{\"type\":\"bar\",\"cornerRadiusEnd\":4,\"height\":{\"band\":0.56}},\"encoding\":{\"x\":{\"field\":\"DesvioNorm\",\"type\":\"quantitative\",\"scale\":{\"domain\":[-1.15,1.15]},\"axis\":{\"grid\":false,\"labels\":false}},\"color\":{\"condition\":[{\"test\":\"datum.Desvio > 0\",\"value\":\"#D64545\"},{\"test\":\"datum.Desvio < 0\",\"value\":\"#0F9D76\"}],\"value\":\"#94A3B8\"},\"tooltip\":[{\"field\":\"Area\",\"type\":\"nomina